  "launcher": {
    "mode": "script",
    "wrapper": "/home/ll/deploy/start-flash-next-170hx.sh",
    "inner": "/home/ll/deploy/flash-next-170hx-inner.sh",
    "port": 18420,
    "served": "qwen3.8-flash-next",
    "model": "/media/ll/data/models/Qwen3.8-Flash-Next-NVFP4",
    "modelBytes": 135195303851,
