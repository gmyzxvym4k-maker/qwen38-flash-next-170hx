{
  "key": "sm80-170hx-local",
  "name": "170HX 参数集（本机可运行形态：chroot + TP2 + MTP6 + PLE-mmap）",
  "source": "https://github.com/nguyenthimy2022kg-alt/Qwen-Flash-SM80-170HX",
  "note": "同上游 170HX 参数集，但去掉本机不可用的依赖：无 Docker/GDS（PLE 走 mmap+CPU offload）、无 expert-parallel（双卡 P2P=CNS，EP all-to-all 只能走 SHM）、MoE 后端 auto（草稿 MoE 是 BF16 未量化，marlin 不支持）。官方四个 GDS 专属 hook（draft INT8 / HC GEMV / TileLang 投影 / Triton 预加载）已搬到 mmap 路径并验证可安装。实测 decode 32~40 tok/s（MTP6，接受长度 2.1~3.3）；关掉投机约 50 tok/s 且更稳。官方宣称的 151~168 tok/s 依赖 GDS 直读 + 双卡 P2P，本机不可达。",
  "vllmArgs": [
    "/models/Qwen3.8-Flash-Next-NVFP4",
    "--served-model-name",
    "qwen3.8-flash-next",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--load-format",
    "safetensors",
    "--safetensors-load-strategy",
    "lazy",
    "--distributed-executor-backend",
    "mp",
    "--tensor-parallel-size",
    "2",
    "--pipeline-parallel-size",
    "1",
    "--quantization",
    "modelopt_fp4",
    "--linear-backend",
    "marlin",
    "--moe-backend",
    "marlin",
    "--dtype",
    "bfloat16",
    "--max-model-len",
    "262144",
    "--block-size",
    "1632",
    "--max-num-seqs",
    "8",
    "--gpu-memory-utilization",
    "0.85",
    "--enable-prefix-caching",
    "--mamba-cache-mode",
    "align",
    "--enable-chunked-prefill",
    "--max-num-batched-tokens",
    "8192",
    "--async-scheduling",
    "--reasoning-parser",
    "qwen3",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_coder",
    "--default-chat-template-kwargs",
    "{\"enable_thinking\":true,\"preserve_thinking\":true}",
    "--override-generation-config",
    "{\"temperature\":1.0,\"top_p\":0.95,\"top_k\":20,\"min_p\":0.0,\"presence_penalty\":1.5}",
    "-cc.cudagraph_mode=FULL_AND_PIECEWISE",
    "-cc.splitting_ops=[\"vllm::unified_attention_with_output\",\"vllm::unified_mla_attention_with_output\",\"vllm::mamba_mixer2\",\"vllm::mamba_mixer\",\"vllm::short_conv\",\"vllm::qwen3_8_flash_next_ple_short_conv\",\"vllm::qwen3_8_flash_next_qsa_with_output\",\"vllm::linear_attention\",\"vllm::qwen_gdn_attention_core\",\"vllm::qwen_gdn_attention_core_fused_norm_packed\",\"vllm::sparse_attn_indexer\",\"vllm::ple_mmap_lookup\",\"vllm::ple_gds_lookup\"]",
    "-cc.inductor_compile_config={\"combo_kernels\":false,\"benchmark_combo_kernel\":false}",
    "--no-enable-flashinfer-autotune",
    "--speculative-config",
    "{\"method\": \"mtp\", \"num_speculative_tokens\": 6, \"use_local_argmax_reduction\": true}",
    "--enable-expert-parallel"
  ],
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "VLLM_PLE_MMAP": "0",
    "VLLM_PLE_NVFP4_GPU": "0",
    "GDN_DIAG_DISABLE_JIT_MONITOR": "1",
    "VLLM_PLE_GDS_RUNNER": "1",
    "VLLM_PLE_GDS_STAGING_SLOTS": "3",
    "VLLM_LOGGING_LEVEL": "INFO",
    "VLLM_PLE_GDS_WORKERS": "32",
    "VLLM_PLE_GDS_RUNNER_METRICS_INTERVAL": "5",
    "CUFILE_LOGGING_LEVEL": "INFO",
    "CUFILE_USE_PCIP2PDMA": "1",
    "VLLM_PLE_GDS_IPC_PROCESS": "0",
    "R38_PP1_FULL_DECODE": "0",
    "VLLM_PLE_GDS": "1",
    "VLLM_PLE_GDS_PHASE_TIMING": "0",
    "VLLM_PLE_MMAP_PREWARM": "0",
    "VLLM_PLE_CPU_OFFLOAD": "0",
    "VLLM_PLE_MMAP_CHUNK": "2048",
    "R38_TOKEN_DIAGNOSTICS": "0",
    "VLLM_PLE_GDS_INPUT_DRIVEN": "1",
    "VLLM_PLE_GDS_CACHE_ROWS": "0",
    "QWEN_GDN_REPLAY": "1",
    "Q38_TP_PLE": "1",
    "Q38_TP_PLE_VERIFY_STEPS": "8",
    "Q38_HC_GEMV": "1",
    "CUDA_MODULE_LOADING": "LAZY",
    "PYTORCH_NVML_BASED_CUDA_CHECK": "1",
